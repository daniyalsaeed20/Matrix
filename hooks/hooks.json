{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/m4trix-workspace-open.ps1",
        "timeout": 120
      }
    ],
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/m4trix-session-start.ps1",
        "timeout": 20
      }
    ]
  }
}
